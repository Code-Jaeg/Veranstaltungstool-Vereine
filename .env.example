# Öffentliche Adresse der Anwendung (wird in Mails, PDFs und Kalendereinträgen verwendet)
BASE_URL=https://dienste.jaeger-sauer.de
APP_NAME=Vereinsdienste

# Passwort, das zum Anlegen neuer Veranstaltungen nötig ist (leer = jeder darf anlegen)
CREATE_PASSWORD=bitte-aendern

# SMTP-Versand (ohne SMTP_HOST werden Mails nur als .eml in data/outbox abgelegt)
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=dienste@jaeger-sauer.de
SMTP_PASS=geheim
MAIL_FROM="Vereinsdienste <dienste@jaeger-sauer.de>"

# Erinnerungen: Stunden vor Dienstbeginn, kommagetrennt
REMINDER_HOURS=48,3

# Personenbezogene Daten X Tage nach der Veranstaltung automatisch löschen (0 = nie)
DATA_RETENTION_DAYS=30

# Optional: Mails statt per SMTP an einen n8n-Webhook übergeben
MAIL_WEBHOOK_URL=

# Optional: n8n-Webhook für Anmeldungen/Absagen
N8N_WEBHOOK_URL=
WEBHOOK_SECRET=

# Angaben für /impressum und /datenschutz
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
OPERATOR_REPRESENTATIVE=
OPERATOR_REGISTER=

# Optional: Links im Footer
IMPRINT_URL=
PRIVACY_URL=
