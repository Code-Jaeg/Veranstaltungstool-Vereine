<%- include('partials/head', { title: event.title, navTitle: event.organization || event.title }) %>

<h1 class="large-title"><%= event.title %></h1>
<div class="hero">
  <div class="meta">
    <div>📅 <span><%= u.fmtDate(event.event_date) %></span></div>
    <% if (event.location) { %><div>📍 <span><%= event.location %></span></div><% } %>
    <div>👤 <span><%= event.admin_name %><% if (event.admin_phone) { %> · <a href="tel:<%= event.admin_phone %>"><%= event.admin_phone %></a><% } %> · <a href="mailto:<%= event.admin_email %>">E-Mail</a></span></div>
  </div>
  <% if (event.description) { %><p><%= event.description %></p><% } %>
</div>

<% if (!shifts.length) { %>
  <h2 class="section-header big" id="dienste">Dienste</h2>
  <div class="group"><div class="empty">Es wurden noch keine Dienste angelegt.</div></div>
<% } else { %>
<form method="post" action="/e/<%= event.public_token %>/anmelden" id="anmelden">
  <p class="muted small" style="margin:16px 4px 0">Tippe alle Dienste an, bei denen du helfen möchtest – du trägst dich danach mit einem Formular für alle zusammen ein. Ist ein Dienst voll, kommst du auf die Warteliste und rückst automatisch nach.</p>

  <%- include('partials/pick', { list: shifts, selected: selected, values: values, showPeople: true }) %>

  <div class="section-header" id="daten">Deine Angaben</div>
  <div class="group">
    <label class="field"><span>Name</span><input name="name" required maxlength="100" autocomplete="name" placeholder="Vor- und Nachname" value="<%= values.name || '' %>"></label>
    <label class="field"><span>E-Mail</span><input type="email" name="email" required autocomplete="email" placeholder="für Bestätigung & Erinnerung" value="<%= values.email || '' %>"></label>
    <label class="field"><span>Telefon</span><input type="tel" name="phone" autocomplete="tel" placeholder="optional, für kurzfristige Absprachen" value="<%= values.phone || '' %>"></label>
    <label class="field"><span>Bemerkung</span><input name="note" maxlength="300" placeholder="optional" value="<%= values.note || '' %>"></label>
  </div>
  <label class="hp" aria-hidden="true">Website <input name="website" tabindex="-1" autocomplete="off"></label>
  <div class="group" style="margin-top:12px">
    <label class="check"><input type="checkbox" name="privacy" value="1" required <%= values.privacy ? 'checked' : '' %>>
      <span>Meine Kontaktdaten dürfen zur Organisation gespeichert werden. Sichtbar sind sie nur für das Organisationsteam; öffentlich erscheint nur „Vorname N.“. <a href="/datenschutz">Datenschutz</a></span></label>
  </div>
  <div class="submitbar">
    <button class="btn" type="submit" data-count-label="Eintragen">Eintragen</button>
  </div>
</form>
<% } %>

<h2 class="section-header big" id="pinnwand">Pinnwand</h2>
<div class="group">
  <% if (!messages.length) { %><div class="empty">Noch keine Nachrichten.</div><% } %>
  <% messages.forEach(function (m) { %>
    <div class="message <%= m.is_admin ? 'admin' : '' %>">
      <div class="head"><span class="author"><%= m.author %></span><span><%= new Date(m.created_at.replace(' ', 'T') + 'Z').toLocaleString('de-DE', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }) %></span></div>
      <div class="body"><%= m.body %></div>
    </div>
  <% }) %>
</div>

<div class="section-header">Nachricht schreiben</div>
<form method="post" action="/e/<%= event.public_token %>/messages">
  <div class="group">
    <label class="field"><span>Name</span><input name="author" required maxlength="60" autocomplete="name" value="<%= values.author || '' %>"></label>
    <label class="field stack"><span>Nachricht</span><textarea name="body" required maxlength="2000" placeholder="Fragen, Absprachen, Fahrgemeinschaften …"><%= values.body || '' %></textarea></label>
  </div>
  <label class="hp" aria-hidden="true">Website <input name="website" tabindex="-1" autocomplete="off"></label>
  <div class="section-footer">Die Pinnwand ist für alle sichtbar, die den Link kennen.</div>
  <button class="btn secondary" type="submit">Veröffentlichen</button>
</form>

<div class="section-footer center" style="margin-top:24px">Schon eingetragen? Über den Link in deiner Bestätigungsmail siehst du alle deine Dienste, kannst weitere hinzufügen oder absagen.</div>
<%- include('partials/foot') %>
